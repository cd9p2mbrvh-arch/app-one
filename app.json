{
  "expo": {
    "name": "App One",
    "slug": "app-one",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.appone.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F6F6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.appone.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "appone",
    "plugins": ["expo-router", "expo-font", "expo-asset"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c088cf91-f260-4f1e-a676-461cc2f88240"
      }
    },
    "owner": "pavulon",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c088cf91-f260-4f1e-a676-461cc2f88240"
    }
  }
}
